{
  "info": {
    "_postman_id": "ecommerce-api-collection",
    "name": "E-Commerce Microservices API",
    "description": "Complete Postman collection for E-Commerce Microservices API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "description": "Tokens come from Keycloak, the platform's only identity provider - there is no login endpoint on the API. Fill keycloak_client_secret / username / password in your environment from your git-ignored .env (E2E_CLIENT_SECRET, E2E_ADMIN_PASSWORD, ...), run 'Get access token', and every other request picks the token up from {{token}}.",
      "item": [
        {
          "name": "Get access token (Keycloak, password grant - development only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('token issued', function () { pm.response.to.have.status(200); });",
                  "pm.environment.set('token', pm.response.json().access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "client_id",
                  "value": "{{keycloak_client_id}}"
                },
                {
                  "key": "client_secret",
                  "value": "{{keycloak_client_secret}}"
                },
                {
                  "key": "username",
                  "value": "{{username}}"
                },
                {
                  "key": "password",
                  "value": "{{password}}"
                }
              ]
            },
            "url": {
              "raw": "{{keycloak_url}}/realms/ecommerce/protocol/openid-connect/token",
              "host": [
                "{{keycloak_url}}"
              ],
              "path": [
                "realms",
                "ecommerce",
                "protocol",
                "openid-connect",
                "token"
              ]
            }
          },
          "response": []
        }
      ]
    },
