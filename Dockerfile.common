# Multi-stage build for shared build context
FROM maven:3.8-openjdk-11 as maven-builder

WORKDIR /build

COPY pom.xml .
COPY common ./common
COPY services/pom.xml ./services/
COPY infrastructure/pom.xml ./infrastructure/

RUN mvn clean install -DskipTests -f common/pom.xml

# Base image for services
FROM openjdk:11-jre-slim

RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=3 \
  CMD curl -f http://localhost:${SERVER_PORT:-8080}/actuator/health/readiness || exit 1
