<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <changeSet id="001-initial-customers-schema" author="claude">
        <createTable tableName="customers" remarks="Customers table">
            <column name="id" type="BIGINT" remarks="Unique identifier">
                <constraints primaryKey="true" primaryKeyName="pk_customers"/>
            </column>
            <column name="name" type="VARCHAR(100)" remarks="Customer name">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)" remarks="Customer email">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_customers_email"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP" remarks="Creation timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP" remarks="Update timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="002-customers-indexes" author="claude">
        <createIndex indexName="idx_customers_email" tableName="customers" unique="true">
            <column name="email"/>
        </createIndex>
        <createIndex indexName="idx_customers_created_at" tableName="customers">
            <column name="created_at"/>
        </createIndex>
    </changeSet>

    <changeSet id="003-audit-log-table" author="claude">
        <createTable tableName="audit_logs" remarks="Audit log for customer operations">
            <column name="id" type="BIGINT" remarks="Unique identifier">
                <constraints primaryKey="true" primaryKeyName="pk_audit_logs"/>
            </column>
            <column name="entity_type" type="VARCHAR(100)" remarks="Type of entity being audited">
                <constraints nullable="false"/>
            </column>
            <column name="entity_id" type="BIGINT" remarks="ID of the entity">
                <constraints nullable="false"/>
            </column>
            <column name="action" type="VARCHAR(50)" remarks="Action performed (CREATE, UPDATE, DELETE)">
                <constraints nullable="false"/>
            </column>
            <column name="changed_fields" type="TEXT" remarks="JSON representation of changed fields"/>
            <column name="old_values" type="TEXT" remarks="JSON representation of old values"/>
            <column name="new_values" type="TEXT" remarks="JSON representation of new values"/>
            <column name="performed_by" type="VARCHAR(255)" remarks="User who performed the action">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP" remarks="Creation timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="004-audit-log-indexes" author="claude">
        <createIndex indexName="idx_audit_logs_entity" tableName="audit_logs">
            <column name="entity_type"/>
            <column name="entity_id"/>
        </createIndex>
        <createIndex indexName="idx_audit_logs_created_at" tableName="audit_logs">
            <column name="created_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
