<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-initial-payments-schema" author="claude">
        <createTable tableName="payments" remarks="Payments table">
            <column name="id" type="BIGINT" remarks="Unique identifier">
                <constraints primaryKey="true" primaryKeyName="pk_payments"/>
            </column>
            <column name="order_id" type="BIGINT" remarks="Reference to order">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="DECIMAL(10,2)" remarks="Payment amount">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(50)" remarks="Payment status (PENDING, COMPLETED, FAILED, REFUNDED)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP" remarks="Creation timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP" remarks="Update timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="002-payments-indexes" author="claude">
        <createIndex indexName="idx_payments_order_id" tableName="payments">
            <column name="order_id"/>
        </createIndex>
        <createIndex indexName="idx_payments_status" tableName="payments">
            <column name="status"/>
        </createIndex>
        <createIndex indexName="idx_payments_created_at" tableName="payments">
            <column name="created_at"/>
        </createIndex>
        <createIndex indexName="idx_payments_order_status" tableName="payments">
            <column name="order_id"/>
            <column name="status"/>
        </createIndex>
    </changeSet>

    <changeSet id="003-payment-events-table" author="claude">
        <createTable tableName="payment_events" remarks="Event sourcing for payments">
            <column name="id" type="BIGINT" remarks="Unique identifier">
                <constraints primaryKey="true" primaryKeyName="pk_payment_events"/>
            </column>
            <column name="payment_id" type="BIGINT" remarks="Reference to payment">
                <constraints nullable="false"/>
            </column>
            <column name="event_type" type="VARCHAR(100)" remarks="Event type (PaymentInitiated, PaymentProcessed, PaymentFailed, PaymentRefunded, etc)">
                <constraints nullable="false"/>
            </column>
            <column name="event_data" type="TEXT" remarks="JSON representation of event data">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP" remarks="Event timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="004-payment-events-indexes" author="claude">
        <createIndex indexName="idx_payment_events_payment_id" tableName="payment_events">
            <column name="payment_id"/>
        </createIndex>
        <createIndex indexName="idx_payment_events_type" tableName="payment_events">
            <column name="event_type"/>
        </createIndex>
        <createIndex indexName="idx_payment_events_created_at" tableName="payment_events">
            <column name="created_at"/>
        </createIndex>
    </changeSet>

    <changeSet id="005-audit-log-table" author="claude">
        <createTable tableName="audit_logs" remarks="Audit log for payment operations">
            <column name="id" type="BIGINT" remarks="Unique identifier">
                <constraints primaryKey="true" primaryKeyName="pk_audit_logs"/>
            </column>
            <column name="entity_type" type="VARCHAR(100)" remarks="Type of entity being audited">
                <constraints nullable="false"/>
            </column>
            <column name="entity_id" type="BIGINT" remarks="ID of the entity">
                <constraints nullable="false"/>
            </column>
            <column name="action" type="VARCHAR(50)" remarks="Action performed (CREATE, UPDATE, DELETE)">
                <constraints nullable="false"/>
            </column>
            <column name="changed_fields" type="TEXT" remarks="JSON representation of changed fields"/>
            <column name="old_values" type="TEXT" remarks="JSON representation of old values"/>
            <column name="new_values" type="TEXT" remarks="JSON representation of new values"/>
            <column name="performed_by" type="VARCHAR(255)" remarks="User who performed the action">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP" remarks="Creation timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="006-audit-log-indexes" author="claude">
        <createIndex indexName="idx_audit_logs_entity" tableName="audit_logs">
            <column name="entity_type"/>
            <column name="entity_id"/>
        </createIndex>
        <createIndex indexName="idx_audit_logs_created_at" tableName="audit_logs">
            <column name="created_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
