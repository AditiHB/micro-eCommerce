<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-initial-orders-schema" author="claude">
        <createTable tableName="orders" remarks="Orders table">
            <column name="id" type="BIGINT" remarks="Unique identifier">
                <constraints primaryKey="true" primaryKeyName="pk_orders"/>
            </column>
            <column name="customer_id" type="BIGINT" remarks="Reference to customer">
                <constraints nullable="false"/>
            </column>
            <column name="product_id" type="VARCHAR(100)" remarks="Product identifier">
                <constraints nullable="false"/>
            </column>
            <column name="quantity" type="INT" remarks="Order quantity">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(50)" remarks="Order status (PENDING, PROCESSING, COMPLETED, CANCELLED)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP" remarks="Creation timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP" remarks="Update timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="002-orders-indexes" author="claude">
        <createIndex indexName="idx_orders_customer_id" tableName="orders">
            <column name="customer_id"/>
        </createIndex>
        <createIndex indexName="idx_orders_product_id" tableName="orders">
            <column name="product_id"/>
        </createIndex>
        <createIndex indexName="idx_orders_status" tableName="orders">
            <column name="status"/>
        </createIndex>
        <createIndex indexName="idx_orders_created_at" tableName="orders">
            <column name="created_at"/>
        </createIndex>
        <createIndex indexName="idx_orders_customer_status" tableName="orders">
            <column name="customer_id"/>
            <column name="status"/>
        </createIndex>
    </changeSet>

    <changeSet id="003-event-sourcing-table" author="claude">
        <createTable tableName="order_events" remarks="Event sourcing for orders">
            <column name="id" type="BIGINT" remarks="Unique identifier">
                <constraints primaryKey="true" primaryKeyName="pk_order_events"/>
            </column>
            <column name="order_id" type="BIGINT" remarks="Reference to order">
                <constraints nullable="false"/>
            </column>
            <column name="event_type" type="VARCHAR(100)" remarks="Event type (OrderCreated, OrderProcessed, OrderCancelled, etc)">
                <constraints nullable="false"/>
            </column>
            <column name="event_data" type="TEXT" remarks="JSON representation of event data">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP" remarks="Event timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="004-event-sourcing-indexes" author="claude">
        <createIndex indexName="idx_order_events_order_id" tableName="order_events">
            <column name="order_id"/>
        </createIndex>
        <createIndex indexName="idx_order_events_type" tableName="order_events">
            <column name="event_type"/>
        </createIndex>
        <createIndex indexName="idx_order_events_created_at" tableName="order_events">
            <column name="created_at"/>
        </createIndex>
    </changeSet>

    <changeSet id="005-audit-log-table" author="claude">
        <createTable tableName="audit_logs" remarks="Audit log for order operations">
            <column name="id" type="BIGINT" remarks="Unique identifier">
                <constraints primaryKey="true" primaryKeyName="pk_audit_logs"/>
            </column>
            <column name="entity_type" type="VARCHAR(100)" remarks="Type of entity being audited">
                <constraints nullable="false"/>
            </column>
            <column name="entity_id" type="BIGINT" remarks="ID of the entity">
                <constraints nullable="false"/>
            </column>
            <column name="action" type="VARCHAR(50)" remarks="Action performed (CREATE, UPDATE, DELETE)">
                <constraints nullable="false"/>
            </column>
            <column name="changed_fields" type="TEXT" remarks="JSON representation of changed fields"/>
            <column name="old_values" type="TEXT" remarks="JSON representation of old values"/>
            <column name="new_values" type="TEXT" remarks="JSON representation of new values"/>
            <column name="performed_by" type="VARCHAR(255)" remarks="User who performed the action">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP" remarks="Creation timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="006-audit-log-indexes" author="claude">
        <createIndex indexName="idx_audit_logs_entity" tableName="audit_logs">
            <column name="entity_type"/>
            <column name="entity_id"/>
        </createIndex>
        <createIndex indexName="idx_audit_logs_created_at" tableName="audit_logs">
            <column name="created_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
