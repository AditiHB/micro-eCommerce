<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <changeSet id="001-initial-notifications-schema" author="claude">
        <createTable tableName="notifications" remarks="Customer notifications table">
            <column name="id" type="BIGINT" remarks="Unique identifier">
                <constraints primaryKey="true" primaryKeyName="pk_notifications"/>
            </column>
            <column name="customer_id" type="BIGINT" remarks="Reference to customer">
                <constraints nullable="false"/>
            </column>
            <column name="order_id" type="BIGINT" remarks="Reference to order (nullable for non-order notifications)"/>
            <column name="type" type="VARCHAR(50)" remarks="Notification type (ORDER_CREATED, PAYMENT_SUCCESS, PAYMENT_FAILED)">
                <constraints nullable="false"/>
            </column>
            <column name="recipient" type="VARCHAR(255)" remarks="Destination address (e.g. email)">
                <constraints nullable="false"/>
            </column>
            <column name="subject" type="VARCHAR(255)" remarks="Notification subject line">
                <constraints nullable="false"/>
            </column>
            <column name="message" type="VARCHAR(2000)" remarks="Notification body">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)" defaultValue="PENDING" remarks="Delivery status (PENDING, SENT, FAILED)">
                <constraints nullable="false"/>
            </column>
            <column name="error_message" type="VARCHAR(500)" remarks="Delivery failure reason, if any"/>
            <column name="source_event_id" type="VARCHAR(100)" remarks="ID of the Kafka event that triggered this notification (idempotency key)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP" remarks="Creation timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP" remarks="Update timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="002-notifications-unique-source-event" author="claude">
        <addUniqueConstraint tableName="notifications"
                              columnNames="source_event_id"
                              constraintName="uk_notifications_source_event_id"/>
    </changeSet>

    <changeSet id="003-notifications-indexes" author="claude">
        <createIndex indexName="idx_notifications_customer_id" tableName="notifications">
            <column name="customer_id"/>
        </createIndex>
        <createIndex indexName="idx_notifications_order_id" tableName="notifications">
            <column name="order_id"/>
        </createIndex>
        <createIndex indexName="idx_notifications_type" tableName="notifications">
            <column name="type"/>
        </createIndex>
        <createIndex indexName="idx_notifications_status" tableName="notifications">
            <column name="status"/>
        </createIndex>
        <createIndex indexName="idx_notifications_created_at" tableName="notifications">
            <column name="created_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
