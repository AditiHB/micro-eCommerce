# Stage 1: Build
FROM maven:3.9.9-eclipse-temurin-17 as builder

WORKDIR /build

COPY pom.xml .
COPY common ./common
COPY infrastructure/pom.xml ./infrastructure/
COPY services/pom.xml ./services/
COPY infrastructure/api-gateway ./infrastructure/api-gateway/

RUN mvn clean package -DskipTests -pl infrastructure/api-gateway -am

# Stage 2: Runtime
FROM eclipse-temurin:17-jre-jammy

RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /build/infrastructure/api-gateway/target/api-gateway-*.jar app.jar

EXPOSE 8080

ENV SERVER_PORT=8080

HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=3 \
  CMD curl -f http://localhost:8080/actuator/health/readiness || exit 1

ENTRYPOINT ["java", "-jar", "app.jar"]
