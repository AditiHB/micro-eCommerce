# Stage 1: Build
FROM maven:3.9.9-eclipse-temurin-17 as builder

WORKDIR /build

COPY pom.xml .
COPY common ./common
COPY infrastructure/pom.xml ./infrastructure/
COPY services/pom.xml ./services/
COPY infrastructure/discovery-server/pom.xml ./infrastructure/discovery-server/
COPY infrastructure/api-gateway/pom.xml ./infrastructure/api-gateway/
COPY services/customer-service/pom.xml ./services/customer-service/
COPY services/inventory-service/pom.xml ./services/inventory-service/
COPY services/order-service/pom.xml ./services/order-service/
COPY services/payment-service/pom.xml ./services/payment-service/
COPY services/notification-service/pom.xml ./services/notification-service/
COPY infrastructure/config-server ./infrastructure/config-server/

RUN mvn clean package -DskipTests -pl infrastructure/config-server -am

# Stage 2: Runtime
FROM eclipse-temurin:17-jre-jammy

# git: config-repo must be a real working copy for Config Server's git backend to read (see
# docker-entrypoint.sh) - initialised at container start, not baked in here, so the same mechanism also
# covers Docker Compose's bind-mounted ./config-repo (not available until the container actually runs).
RUN apt-get update && apt-get install -y curl git && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /build/infrastructure/config-server/target/config-server-*.jar app.jar
COPY config-repo /app/config-repo
COPY infrastructure/config-server/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

EXPOSE 8888

ENV SERVER_PORT=8888

# Probes use the management port: it is internal-only (not published, not routed by the gateway), so
# liveness/readiness and metrics never share a port with - or need credentials on - the public API.
ENV MANAGEMENT_SERVER_PORT=9888

HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=3 \
  CMD curl -f http://localhost:9888/actuator/health/readiness || exit 1

# Run as an unprivileged user: a compromised JVM must not be root inside the container.
RUN groupadd --system --gid 10001 app \
 && useradd --system --uid 10001 --gid app --no-create-home --shell /usr/sbin/nologin app \
 && chown -R app:app /app
USER 10001:10001

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh", "java", "-jar", "app.jar"]
