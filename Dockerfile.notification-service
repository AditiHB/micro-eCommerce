# Stage 1: Build
FROM maven:3.9.9-eclipse-temurin-17 as builder

WORKDIR /build

COPY pom.xml .
COPY common ./common
COPY infrastructure/pom.xml ./infrastructure/
COPY services/pom.xml ./services/
COPY infrastructure/config-server/pom.xml ./infrastructure/config-server/
COPY infrastructure/discovery-server/pom.xml ./infrastructure/discovery-server/
COPY infrastructure/api-gateway/pom.xml ./infrastructure/api-gateway/
COPY services/customer-service/pom.xml ./services/customer-service/
COPY services/inventory-service/pom.xml ./services/inventory-service/
COPY services/payment-service/pom.xml ./services/payment-service/
COPY services/product-service/pom.xml ./services/product-service/
COPY services/order-service/pom.xml ./services/order-service/
COPY services/notification-service/ ./services/notification-service/

RUN mvn clean package -DskipTests -pl services/notification-service -am

# Stage 2: Runtime
FROM eclipse-temurin:17-jre-jammy

RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /build/services/notification-service/target/notification-service-*.jar app.jar

EXPOSE 8086

ENV SERVER_PORT=8086

# Probes use the management port: it is internal-only (not published, not routed by the gateway), so
# liveness/readiness and metrics never share a port with - or need credentials on - the public API.
ENV MANAGEMENT_SERVER_PORT=9086

HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=3 \
  CMD curl -f http://localhost:9086/actuator/health/readiness || exit 1

# Run as an unprivileged user: a compromised JVM must not be root inside the container.
RUN groupadd --system --gid 10001 app \
 && useradd --system --uid 10001 --gid app --no-create-home --shell /usr/sbin/nologin app \
 && chown -R app:app /app
USER 10001:10001

ENTRYPOINT ["java", "-jar", "app.jar"]
