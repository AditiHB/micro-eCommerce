# ----------------------------------------------------------------------------------------------
# .env.example - the NAMES of the secrets the stack needs. It deliberately contains no values.
#
# Do not copy this file. Run  scripts/gen-env.sh  - it creates a git-ignored .env holding
# freshly generated random values for every variable below. Re-running it only adds what is missing;
# to rotate one secret delete its line and run it again.
# ----------------------------------------------------------------------------------------------

# --- datastores -------------------------------------------------------------------------------
POSTGRES_ADMIN_PASSWORD=
CUSTOMER_DB_PASSWORD=
ORDER_DB_PASSWORD=
INVENTORY_DB_PASSWORD=
PAYMENT_DB_PASSWORD=
NOTIFICATION_DB_PASSWORD=
REDIS_PASSWORD=
VAULT_DB_ADMIN_PASSWORD=       # only used by the Vault overlay (dynamic database logins)

# --- identity provider (Keycloak) ---------------------------------------------------------------
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=
NOTIFICATION_CLIENT_SECRET=    # notification-service's OAuth2 client-credentials secret

# --- development-only identities (Karate suite, scripts) ----------------------------------------
E2E_CLIENT_SECRET=
E2E_ADMIN_PASSWORD=
E2E_MANAGER_PASSWORD=
E2E_USER_PASSWORD=

# --- platform ----------------------------------------------------------------------------------
EUREKA_PASSWORD=
CONFIG_SERVER_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# --- PKI (docker-compose.pki.yml) ---------------------------------------------------------------
STEP_CA_PASSWORD=              # protects the CA keys and is the `admin` provisioner password

# Not secrets, but commonly overridden:
#   CORS_ALLOWED_ORIGINS=http://localhost:3000
#   SPRING_PROFILES_ACTIVE=postgres        (see .env.postgres)
