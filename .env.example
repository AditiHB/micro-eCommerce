# ============================================================
# SECRETS CONFIGURATION - EXAMPLE FILE
# ============================================================
#
# IMPORTANT: This is an EXAMPLE file only!
# DO NOT use these values in PRODUCTION or any real environment.
# Copy this file to .env and update with actual secrets for LOCAL DEVELOPMENT.
#
# Never commit the actual .env file to git!
# Add .env to .gitignore
#
# ============================================================

# JWT Configuration
JWT_SECRET=development-secret-key-not-for-production-use-only

# Database Credentials
DB_USERNAME=sa
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_USERNAME=
KAFKA_PASSWORD=

# Elasticsearch Configuration
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme

# Application Settings
SPRING_PROFILES_ACTIVE=dev,h2
APP_ENV=development

# Eureka Configuration
EUREKA_SERVER_URL=http://localhost:8761/eureka/

# Config Server
CONFIG_SERVER_URL=http://localhost:8888

# Logging
LOG_LEVEL=DEBUG
