# Stage 1: Build
FROM maven:3.9.9-eclipse-temurin-17 as builder

WORKDIR /build

COPY pom.xml .
COPY common ./common
COPY services/pom.xml ./services/
COPY services/customer-service/pom.xml ./services/customer-service/
COPY services/order-service/pom.xml ./services/order-service/
COPY services/payment-service/pom.xml ./services/payment-service/
COPY services/product-service/pom.xml ./services/product-service/
COPY services/inventory-service ./services/inventory-service/
COPY infrastructure/pom.xml ./infrastructure/

RUN mvn clean package -DskipTests -pl services/inventory-service -am

# Stage 2: Runtime
FROM eclipse-temurin:17-jre-jammy

RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /build/services/inventory-service/target/inventory-service-*.jar app.jar

EXPOSE 8082

ENV SERVER_PORT=8082

HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=3 \
  CMD curl -f http://localhost:8082/actuator/health/readiness || exit 1

ENTRYPOINT ["java", "-jar", "app.jar"]
