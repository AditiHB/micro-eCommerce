# Stage 1: Build
FROM maven:3.8-openjdk-11 as builder

WORKDIR /build

COPY pom.xml .
COPY common ./common
COPY services/pom.xml ./services/
COPY services/inventory-service ./services/inventory-service/
COPY infrastructure/pom.xml ./infrastructure/

RUN mvn clean package -DskipTests -pl services/inventory-service -am

# Stage 2: Runtime
FROM openjdk:11-jre-slim

RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /build/services/inventory-service/target/inventory-service-*.jar app.jar

EXPOSE 8083

ENV SERVER_PORT=8083

HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=3 \
  CMD curl -f http://localhost:8083/actuator/health/readiness || exit 1

ENTRYPOINT ["java", "-jar", "app.jar"]
