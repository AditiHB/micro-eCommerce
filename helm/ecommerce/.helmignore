# Patterns to ignore when building packages.
# This supports shell glob patterns, relative paths relative to the chart
# root directory. Files matching the patterns will not be included in the
# packaged chart.
.DS_Store
.git
.gitignore
.bzr
.bzrignore
.hg
.hgignore
.svn
CVS
*.swp
*.swo
*~
.idea
.vscode
*.swp
*.swo
*~
.DS_Store
