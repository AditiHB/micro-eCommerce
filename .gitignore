# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Docker
Dockerfile
.dockerignore

# IDE
.vscode/
.idea/
*.iml
.classpath
.project
.settings/

# Maven
target/

# Environment Variables (NEVER commit real secrets; .env.postgres has no
# secrets - just profile-switching flags - so it is intentionally tracked)
.env
.env.local
.env.*.local

# Secret rotation logs
infrastructure/scripts/*.log
infrastructure/scripts/*.audit.json

# Key material is generated, never committed (certificates come from the smallstep CA, see docs/SMALLSTEP_PKI.md)
infrastructure/nginx/certs/*
!infrastructure/nginx/certs/.gitkeep
.vault/
*.pem
*.key
*.p12
*.jks
k8s/base/generated/
k8s/overlays/*/generated/
