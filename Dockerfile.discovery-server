# Stage 1: Build
FROM maven:3.8-openjdk-17 as builder

WORKDIR /build

COPY pom.xml .
COPY common ./common
COPY infrastructure/pom.xml ./infrastructure/
COPY infrastructure/discovery-server ./infrastructure/discovery-server/

RUN mvn clean package -DskipTests -pl infrastructure/discovery-server -am

# Stage 2: Runtime
FROM openjdk:17-jre-slim

RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /build/infrastructure/discovery-server/target/discovery-server-*.jar app.jar

EXPOSE 8761

ENV SERVER_PORT=8761

HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=3 \
  CMD curl -f http://localhost:8761/actuator/health/readiness || exit 1

ENTRYPOINT ["java", "-jar", "app.jar"]
