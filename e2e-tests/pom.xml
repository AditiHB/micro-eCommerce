<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ecommerce</groupId>
    <artifactId>e2e-tests</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>e2e-tests</name>
    <description>
        Karate end-to-end scenarios that exercise the already-running Docker
        Compose stack over HTTP (customer -&gt; catalogue -&gt; order -&gt; payment -&gt;
        notification). Deliberately NOT a child of the root parent POM: it needs
        none of the Spring Boot/Spring Cloud dependencies every service module
        inherits from there, and it must never run as a side effect of a plain
        `mvn clean install` from the repo root - these tests require the stack
        to already be up (see README.md in this module).
    </description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <karate.version>1.4.1</karate.version>
        <!-- Must match the junit-jupiter-api version karate-junit5:1.4.1 pulls
             in transitively - a mismatched junit-jupiter-engine/junit-platform
             version makes Surefire's JUnit Platform provider fail with
             "TestEngine with ID 'junit-jupiter' failed to discover tests". -->
        <junit.version>5.9.3</junit.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.intuit.karate</groupId>
            <artifactId>karate-junit5</artifactId>
            <version>${karate.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Required by Surefire 3.x's JUnit Platform provider; not pulled in
             transitively by either dependency above. -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <version>1.9.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.12.1</version>
            </plugin>
            <!--
                No executions bound here on purpose. Surefire's default test file
                patterns (*Test.java, Test*.java, *Tests.java, *TestCase.java) do
                NOT match CustomerJourneyRunner.java, so `mvn test`/`mvn install`
                never picks it up by accident. Run it explicitly - see README.md.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>
</project>
