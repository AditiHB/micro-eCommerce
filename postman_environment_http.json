{
  "id": "micro-ecommerce-http-env",
  "name": "Micro-eCommerce - Local (HTTP)",
  "values": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "default",
      "enabled": true,
      "description": "API Gateway - customers/orders/payments/inventory/auth are routed through here"
    },
    {
      "key": "notification_base_url",
      "value": "http://localhost:8086",
      "type": "default",
      "enabled": true,
      "description": "notification-service's own port - not routed through the API Gateway"
    },
    {
      "key": "product_base_url",
      "value": "http://localhost:8085",
      "type": "default",
      "enabled": true,
      "description": "product-service's own port - not wired into docker-compose.yml or the gateway"
    },
    {
      "key": "token",
      "value": "",
      "type": "secret",
      "enabled": true,
      "description": "Set this from the Login response's \"token\" field"
    },
    {
      "key": "keycloak_url",
      "value": "http://localhost:8180",
      "type": "default",
      "enabled": true
    },
    {
      "key": "keycloak_client_id",
      "value": "ecommerce-e2e",
      "type": "default",
      "enabled": true
    },
    {
      "key": "keycloak_client_secret",
      "value": "",
      "type": "secret",
      "enabled": true
    },
    {
      "key": "username",
      "value": "karate_admin",
      "type": "default",
      "enabled": true
    },
    {
      "key": "password",
      "value": "",
      "type": "secret",
      "enabled": true
    }
  ],
  "_postman_variable_scope": "environment"
}